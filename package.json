{
  "name": "lithaven-workspace",
  "version": "1.0.0",
  "description": "LitHaven — Modern MERN Academic Book Marketplace & Study Sanctuary",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "start": "concurrently -n \"server,client\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed",
    "server": "npm --prefix backend start",
    "client": "npm --prefix frontend run dev",
    "build:client": "npm --prefix frontend run build"
  },
  "keywords": [
    "mern",
    "mongodb",
    "express",
    "react",
    "node",
    "textbooks",
    "academic-marketplace",
    "study-vault"
  ],
  "author": "Harsh Raj",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
